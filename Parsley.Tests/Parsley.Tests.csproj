<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Parsley.Tests</RootNamespace>
    <AssemblyName>Parsley.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parsley\Parsley.csproj" />
    <!-- compiles synthesized parsers in memory -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="*.xbnf" CopyToOutputDirectory="PreserveNewest" />
    <!-- the sample operator rule grammar, tested as written -->
    <None Include="..\Parsley\ExprOperators.xbnf" Link="ExprOperators.xbnf" CopyToOutputDirectory="PreserveNewest" />
    <!-- the C99 grammar, its hooks and test sources: data for C99Tests, compiled in memory, not into this project -->
    <Compile Remove="c99\**" />
    <None Include="c99\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the language server, but for its entry point, so LanguageServerTests can talk to it in memory -->
    <Compile Include="..\Parsley.LanguageServer\*.cs" Exclude="..\Parsley.LanguageServer\Program.cs" LinkBase="LanguageServer" />
  </ItemGroup>

</Project>
