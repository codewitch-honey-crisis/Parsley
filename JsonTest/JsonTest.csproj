<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BinDir Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)bin\</BinDir>
    <BinDir Condition="'$(BinDir)' == ''">$(MSBuildProjectDirectory)\..\bin\</BinDir>
    <SourceDir>$(MSBuildProjectDirectory)\</SourceDir>
  
    <!-- Paths to json.xbnf + json.lex -->
    <JsonXbnfPath>$(SourceDir)json.xbnf</JsonXbnfPath>
    <JsonLexPath>$(SourceDir)json.lex</JsonLexPath>

    <JsonParserPath>$(SourceDir)JsonParser.cs</JsonParserPath>
    <JsonLexerPath>$(SourceDir)JsonLexer.cs</JsonLexerPath>
  
    <ParsleyDll>&quot;$(ToolsDir)parsley.dll&quot;</ParsleyDll>
    <ParsleyLuthorDll>&quot;$(ToolsDir)parsley-luthor.dll&quot;</ParsleyLuthorDll>

    <QuotedJsonXbnfPath>&quot;$(JsonXbnfPath)&quot;</QuotedJsonXbnfPath>
    <QuotedJsonLexPath>&quot;$(JsonLexPath)&quot;</QuotedJsonLexPath>
    <QuotedJsonParserPath>&quot;$(JsonParserPath)&quot;</QuotedJsonParserPath>
    <QuotedJsonLexerPath>&quot;$(JsonLexerPath)&quot;</QuotedJsonLexerPath>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Generated files: keep them out of the default glob so they're only added once, by the target below -->


  <!-- Step 1: grammar -> JsonParser.cs + json.lex -->
  <Target 
    Name="GenerateJsonParser" 
    BeforeTargets="BeforeBuild" 
    Inputs="$(JsonXbnfPath)" 
    Outputs="$(JsonParserPath);$(JsonLexPath)">
    <Exec Command="dotnet $(ParsleyDll) $(QuotedJsonXbnfPath) -s -l $(QuotedJsonLexPath) -o $(QuotedJsonParserPath)" />
  </Target>

  <!-- Step 2: json.lex -> JsonLexer.cs (runs after the parser has produced json.lex) -->
  <Target 
    Name="GenerateJsonLexer" 
    BeforeTargets="BeforeBuild" 
    DependsOnTargets="GenerateJsonParser" 
    Inputs="$(JsonLexPath)" 
    Outputs="$(JsonLexerPath)">
    <Exec Command="dotnet $(ParsleyLuthorDll) $(QuotedJsonLexPath) -n Json -c JsonLexer -o $(QuotedJsonLexerPath)" />
  </Target>

  <!-- Step 3: always add the generated files to compilation -->
  <!-- <Target Name="IncludeGeneratedJsonSources" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateJsonLexer">
    <ItemGroup>
      <Compile Include="$(JsonLexerPath);$(JsonParserPath)" />
    </ItemGroup>
  </Target> -->
</Project>
